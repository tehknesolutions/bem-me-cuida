{
  "name": "@bemmecuida/mobile",
  "version": "0.10.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/services/*.test.ts src/config/*.test.ts src/diagnostics/*.test.ts src/security/*.test.ts",
    "config:public": "expo config --type public",
    "build:android:development": "npx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:beta": "npx eas-cli@latest build --platform android --profile beta",
    "build:android:rc": "npx eas-cli@latest build --platform android --profile rc",
    "build:android:rc011": "npx eas-cli@latest build --platform android --profile rc011",
    "build:ios:rc011": "npx eas-cli@latest build --platform ios --profile rc011",
    "build:android:hotfix-validation": "npx eas-cli@latest build --platform android --profile hotfix-validation",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "build:ios:production": "npx eas-cli@latest build --platform ios --profile production",
    "submit:android:production": "npx eas-cli@latest submit --platform android --profile production --latest",
    "submit:ios:production": "npx eas-cli@latest submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@bemmecuida/domain": "0.10.0",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~57.0.8",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.2",
    "expo-local-authentication": "~57.0.2",
    "expo-network": "~57.0.0",
    "expo-notifications": "~57.0.5",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-screen-capture": "~57.0.1",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-sqlite": "~57.0.0",
    "expo-updates": "~57.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
