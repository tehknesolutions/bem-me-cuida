{
  "expo": {
    "name": "BemMeCuida",
    "slug": "bem-me-cuida",
    "version": "0.10.0",
    "orientation": "portrait",
    "scheme": "bemmecuida",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tehknesolutions.bemmecuida",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use a biometria para proteger seus registros no BemMeCuida."
      }
    },
    "android": {
      "package": "com.tehknesolutions.bemmecuida",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F4EE"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-local-authentication", {"faceIDPermission": "Use o Face ID para proteger seus registros no BemMeCuida."}],
      ["expo-sqlite", {"useSQLCipher": true, "enableFTS": true}],
      ["expo-splash-screen", {"backgroundColor": "#F7F4EE", "imageWidth": 220, "image": "./assets/brand-symbol.png", "resizeMode": "contain"}],
      ["expo-notifications", {"defaultChannel": "care-reminders"}]
    ],
    "experiments": {"typedRoutes": true, "reactCompiler": true},
    "icon": "./assets/app-icon.png"
  }
}
